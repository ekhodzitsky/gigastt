#!/bin/bash
set -euo pipefail

echo "[pre-commit] Checking public content..."
python3 scripts/check-publication.py

echo "[pre-commit] Running format check..."
cargo fmt --all --check

echo "[pre-commit] Running clippy..."
cargo clippy --workspace --all-targets -- -D warnings

echo "[pre-commit] Running typos..."
if command -v typos >/dev/null 2>&1; then
  typos
else
  echo "  (typos not installed — skipping; 'brew install typos-cli' or 'cargo install typos-cli' to enable)"
fi

echo "[pre-commit] Running unit + bin tests..."
cargo test --workspace --lib --bins

echo "[pre-commit] All checks passed."
