# Keep the build context small: only files the Dockerfile actually COPYs
# should reach the daemon. Everything else here either bloats the upload
# or is a source of unnecessary cache invalidations on edits.

# Build artefacts
target/
*.tar.gz

# IDE / editor / OS noise
.git/
.github/
.idea/
.vscode/
.DS_Store

# OMC workspace state
.omc/
.omx/
.claude/

# Research, tooling & packaging not needed by the Docker build
# (benchmark/ stays in the context: benchmark/Dockerfile COPYs it)
roadmap/
examples/
fuzz/
scripts/
sdks/
packaging/
ffi/
Formula/
train/
.agents/
.gstack/
.kimi/
.kimi-code/
backlog/
agents/
.grok/
.githooks/
.cargo/

# Docs & specs
docs/
specs/
CHANGELOG.md
README.md
CLAUDE.md
AGENTS.md

# Local caches and generated files can exist below COPYed source directories.
**/target/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/*.profraw
**/*.profdata
**/cobertura*.xml
**/htmlcov/
**/.env
**/.env.*
**/.codex/
**/.cursor/
**/.serena/
**/.aider*
**/.claude-memory-compiler/
**/.codebase-memory*/
**/.backlog/
**/backlog/
**/backlog.config.yml

# Published measurements remain in Git; benchmark images take their inputs
# from mounted datasets and write new results at runtime.
benchmark/results/
benchmark/results_*/
benchmark/results.json
benchmark/results_*.json
benchmark/logs/
