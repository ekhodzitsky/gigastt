# Keep the build context small: only files the Dockerfile actually COPYs
# should reach the daemon. Everything else here either bloats the upload
# or is a source of unnecessary cache invalidations on edits.

# Build artefacts
target/
*.tar.gz

# IDE / editor / OS noise
.git/
.github/
.idea/
.vscode/
.DS_Store

# OMC workspace state
.omc/
.omx/
.claude/

# Research, tooling & packaging not needed by the Docker build
# (benchmark/ stays in the context: benchmark/Dockerfile COPYs it)
roadmap/
examples/
fuzz/
scripts/
sdks/
packaging/
ffi/
Formula/
train/
.agents/
.gstack/
.kimi/
.kimi-code/
backlog/
agents/
.grok/
.githooks/
.cargo/

# Docs & specs
docs/
specs/
CHANGELOG.md
README.md
CLAUDE.md
AGENTS.md
